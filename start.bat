@echo off
chcp 65001 >nul
echo =======================================================
echo 🚀 Запуск системы WB Analytics ^& Local ERP...
echo =======================================================

:: Проверка наличия Node.js
where npm >nul 2>nul
if %errorlevel% neq 0 (
    echo [ОШИБКА] Node.js и npm не найдены! Пожалуйста, скачайте и установите их с https://nodejs.org/
    pause
    exit /b
)

:: Проверка наличия папки node_modules
if not exist node_modules\ (
    echo [ИНФО] Папка node_modules не найдена. Начинаю установку зависимостей...
    call npm install
    echo [УСПЕХ] Зависимости установлены!
) else (
    echo [ИНФО] Зависимости уже установлены. Пропускаю npm install.
)

echo.
echo =======================================================
echo 🌐 Поднятие локального сервера Vite...
echo =======================================================
:: Запуск сервера с автоматическим открытием вкладки в браузере (флаг --open)
call npm run dev -- --open

pause